{
  "name": "coupole-web",
  "version": "0.4.0",
  "private": true,
  "description": "Coupole Web : modules d'astronomie (questions, animations, fiches, tables, images) dans le navigateur, d'après ClassAction (University of Nebraska-Lincoln Astronomy Education).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
