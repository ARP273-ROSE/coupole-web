    { "src": "icons/icone-masquable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icone-masquable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
